---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";

const books = await getCollection("books");
---

<Layout title="Books for devs">
  <main>
    <h1 class="text-center text-7xl font-extrabold mb-24">
      Dev <span class="block">Books</span>
    </h1>

    <section aria-label="Recommended books for devs">
      <div class="px-4 mx-auto max-w-screen-xl">
        <div class="grid gap-6 md:grid-cols-2">
          {
            books.map((book) => {
              const { slug, data } = book;
              const { title, author, img, readtime, description, buy, url } =
                data;
              return (
                <article class="flex ">
                  <a
                    transition:name={`img-${slug}`}
                    href={`/book/${slug}`}
                    class="mb-2 xl:mb-0 transition hover:scale-110 pointer"
                  >
                    <img
                      src={`/${img}`}
                      alt={title}
                      class="mr-5 w-48 rounded"
                    />
                  </a>
                  <div>
                    <h2
                      transition:name={`title-${slug}`}
                      class="mb-2 text-2xl font-bold leading-tight text-white"
                    >
                      {title}
                    </h2>

                    <p class="mb-4 text-gray-300 max-w-sm">{description}</p>
                    <span class="text-xs">
                      Just {readtime} minutes of lecture time
                    </span>
                  </div>
                </article>
              );
            })
          }
        </div>
      </div>
    </section>
  </main>
</Layout>
